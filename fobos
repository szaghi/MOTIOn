[project]
name       = MOTIOn
version    = VERSION
summary    = Modular (HPC) Optimized Toolkit (for) IO (in fortra)n
repository = https://github.com/szaghi/MOTIOn
website    = https://szaghi.github.io/MOTIOn
email      = stefano.zaghi@gmail.it
authors    = Stefano Zaghi

[dependencies]
deps_dir   = src/third_party
BeFoR64    = https://github.com/szaghi/BeFoR64
FACE       = https://github.com/szaghi/FACE
FoXy       = https://github.com/Fortran-FOSS-Programmers/FoXy
PENF       = https://github.com/szaghi/PENF
StringiFor = https://github.com/szaghi/StringiFor

[modes]
modes = shared-gnu static-gnu tests-gnu
        shared-gnu-debug static-gnu-debug tests-gnu-debug
        tests-nvf tests-nvf-debug

[common-variables]
$CSHARED_GNU   = -c -fPIC -frealloc-lhs
$CSHARED_INT   = -c -fpic -assume realloc_lhs
$CSHARED_IBM   = -c -qpic -qmkshrobj -qxlf2003=autorealloc
$LSHARED       = -shared
$CSTATIC_GNU   = -c -frealloc-lhs
$CSTATIC_INT   = -c -assume realloc_lhs
$CSTATIC_IBM   = -c -qxlf2003=autorealloc
$CSTATIC_NVF   = -cpp -c
$DEBUG_GNU     = -Og -g3 -Warray-bounds -Wcharacter-truncation -Wline-truncation -Wimplicit-interface -Wimplicit-procedure -Wunderflow -Wuninitialized -fmodule-private -ffree-line-length-132 -fimplicit-none -fbacktrace -fdump-core -finit-real=nan -std=f2018 -fall-intrinsics
$DEBUG_INT     = -O0 -debug all -check all -warn all -extend-source 132 -traceback -gen-interfaces#-fpe-all=0 -fp-stack-check -fstack-protector-all -ftrapuv -no-ftz -std08
$DEBUG_IBM     = -qcheck=all -qdbg=level=9
$DEBUG_NVF     = -C -gopt -Mbounds -traceback
$OPTIMIZE      = -O2
$HDF5_NVF_25_3 = lib/hdf5/1.14.6/nvf/25.3
$HDF5_GNU_14_2 = lib/hdf5/1.14.6/gnu/14.2.0
$EXDIRS        = BeFoR64/src/tests/ BeFoR64/src/third_party/
                 FACE/src/tests/ FACE/src/third_party/
                 FoXy/src/tests/ FoXy/src/third_party/
                 PENF/src/tests/ PENF/src/third_party/
                 StringiFor/src/tests/ StringiFor/src/third_party/

# main modes
[shared-gnu]
template  = template-shared-gnu
target    = src/lib/motion.F90
build_dir = ./shared/
output    = libmotion.so
mklib     = shared

[static-gnu]
template  = template-static-gnu
target    = src/lib/motion.F90
build_dir = ./static/
output    = libmotion.a
mklib     = static

[tests-gnu]
template  = template-static-gnu
build_dir = ./exe/

[shared-gnu-debug]
template  = template-shared-gnu-debug
target    = src/lib/motion.F90
build_dir = ./shared/
output    = libmotion.so
mklib     = shared

[static-gnu-debug]
template  = template-static-gnu-debug
target    = src/lib/motion.F90
build_dir = ./static/
output    = libmotion.a
mklib     = static

[tests-gnu-debug]
template  = template-static-gnu-debug
build_dir = ./exe/

[tests-nvf]
template  = template-static-nvf
build_dir = ./exe/

[tests-nvf-debug]
template  = template-static-nvf-debug
build_dir = ./exe/

#templates
[template-base]
mpi          = True
mod_dir      = ./mod/
obj_dir      = ./obj/
src          = ./src/
exclude_dirs = $EXDIRS
colors       = True
quiet        = False
log          = True
jobs         = 4

[template-shared-gnu]
template = template-base
compiler = gnu
cflags   = $CSHARED_GNU $OPTIMIZE
lflags   = $LSHARED $OPTIMIZE
preproc  = -D_ASCII_SUPPORTED -D_UCS4_SUPPORTED -D_R16P -w
libs     = $HDF5_GNU_14_2/lib/libhdf5_fortran.a $HDF5_GNU_14_2/lib/libhdf5_f90cstub.a $HDF5_GNU_14_2/lib/libhdf5.a
ext_libs = z
lib_dir  = $HDF5_GNU_14_2/lib
include  = $HDF5_GNU_14_2/include

[template-static-gnu]
template = template-base
compiler = gnu
cflags   = $CSTATIC_GNU $OPTIMIZE
lflags   = $OPTIMIZE
preproc  = -D_ASCII_SUPPORTED -D_UCS4_SUPPORTED -D_R16P -w
libs     = $HDF5_GNU_14_2/lib/libhdf5_fortran.a $HDF5_GNU_14_2/lib/libhdf5_f90cstub.a $HDF5_GNU_14_2/lib/libhdf5.a
ext_libs = z
lib_dir  = $HDF5_GNU_14_2/lib
include  = $HDF5_GNU_14_2/include

[template-shared-gnu-debug]
template = template-base
compiler = gnu
cflags   = $CSHARED_GNU $DEBUG_GNU
lflags   = $LSHARED $DEBUG_GNU
preproc  = -D_ASCII_SUPPORTED -D_UCS4_SUPPORTED -D_R16P -w
libs     = $HDF5_GNU_14_2/lib/libhdf5_fortran.a $HDF5_GNU_14_2/lib/libhdf5_f90cstub.a $HDF5_GNU_14_2/lib/libhdf5.a
ext_libs = z
lib_dir  = $HDF5_GNU_14_2/lib
include  = $HDF5_GNU_14_2/include

[template-static-gnu-debug]
template = template-base
compiler = gnu
cflags   = $CSTATIC_GNU $DEBUG_GNU
lflags   = $DEBUG_GNU
preproc  = -D_ASCII_SUPPORTED -D_UCS4_SUPPORTED -D_R16P -w
libs     = $HDF5_GNU_14_2/lib/libhdf5_fortran.a $HDF5_GNU_14_2/lib/libhdf5_f90cstub.a $HDF5_GNU_14_2/lib/libhdf5.a
ext_libs = z
lib_dir  = $HDF5_GNU_14_2/lib
include  = $HDF5_GNU_14_2/include

[template-static-nvf]
template = template-base
compiler = nvfortran
cflags   = $CSTATIC_NVF -fast
lflags   = -fast
preproc  = -w
libs     = $HDF5_NVF_25_3/lib/libhdf5_fortran.a $HDF5_NVF_25_3/lib/libhdf5_f90cstub.a $HDF5_NVF_25_3/lib/libhdf5.a
ext_libs = z
lib_dir  = $HDF5_NVF_25_3/lib
include  = $HDF5_NVF_25_3/include

[template-static-nvf-debug]
template = template-base
compiler = nvfortran
cflags   = $CSTATIC_NVF $DEBUG_NVF
lflags   = $DEBUG_NVF
preproc  = -w
libs     = $HDF5_NVF_25_3/lib/libhdf5_fortran.a $HDF5_NVF_25_3/lib/libhdf5_f90cstub.a $HDF5_NVF_25_3/lib/libhdf5.a
ext_libs = z
lib_dir  = $HDF5_NVF_25_3/lib
include  = $HDF5_NVF_25_3/include

[rule-makedoc]
help   = Build documentation with formal + VitePress
rule_1 = formal generate --mirror-sources --diagrams --project docs/ford.md --output docs/api
rule_2 = cd docs && npm ci && npm run docs:build

[rule-deldoc]
help = Delete documentation build artifacts
rule = rm -rf docs/.vitepress/dist/ docs/.vitepress/cache/ docs/api/

[rule-delexe]
help = Delete exes
rule = rm -rf exe/

[rule-clean]
help = Clean the project tree
rule_1 = FoBiS.py rule -ex deldoc
rule_2 = FoBiS.py rule -ex delexe
rule_3 = rm -f *.gcov

[rule-maketar]
help = Make tar archive of the project
rule = tar --xform="s%^%MOTIOn/%" -czf MOTIOn.tar.gz *

[rule-makecoverage]
help   = Perform coverage analysis
rule_1 = FoBiS.py rule -ex delexe
rule_2 = FoBiS.py build -mode tests-gnu-debug -coverage
rule_3 = ./scripts/run_tests.sh --np 1
rule_4 = rm -f exe/obj/befor64* exe/obj/face* exe/obj/foxy* exe/obj/penf* exe/obj/stringifor*
rule_5 = ./scripts/compute-coverage.sh

[rule-makecoverage-analysis]
help   = Perform coverage analysis and saving reports in markdown
rule_1 = FoBiS.py rule -ex makecoverage
rule_2 = FoBiS.py rule --gcov-analyzer docs/guide/ --gcov-analyzer coverage-analysis
rule_3 = rm -f *.gcov
